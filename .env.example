# Kopieren nach .env.local und ausfüllen. Beide Werte sind öffentlich (landen im Browser).
# Niemals hier eintragen: service_role / Secret key, Datenbank-Passwort.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Öffentlicher Push-Schlüssel (VAPID); der private Teil gehört nur in die Supabase-Secrets
VITE_VAPID_PUBLIC_KEY=
